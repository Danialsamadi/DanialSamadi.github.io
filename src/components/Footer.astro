---
import { SITE_TITLE, GITHUB_USERNAME } from "@/consts";

const today = new Date();
---

<section id="footer" class="w-full border-t border-[#2a2a2a]">
  <div class="stripes h-2 w-full opacity-60"></div>
  <div
    class="grid grid-cols-2 md:grid-cols-4 gap-1 bg-[#2a2a2a] border-b border-[#2a2a2a] p-px"
  >
    <div class="bg-[#0a0a0a] p-4 tag">
      <span class="opacity-50">UNIT /</span> D-01
    </div>
    <div class="bg-[#0a0a0a] p-4 tag">
      <span class="opacity-50">SRC /</span>
      <a
        href={`https://github.com/${GITHUB_USERNAME}`}
        class="hover:text-hazard"
        target="_blank"
        rel="noopener noreferrer">GITHUB.COM/{GITHUB_USERNAME.toUpperCase()}</a
      >
    </div>
    <div class="bg-[#0a0a0a] p-4 tag">
      <span class="opacity-50">STATUS /</span>
      <span>OPERATIONAL</span>
      <span class="bg-hazard w-2 h-2 inline-block ml-1 blink"></span>
    </div>
    <div class="bg-[#0a0a0a] p-4 tag">
      © {today.getFullYear()}
      {SITE_TITLE.toUpperCase()}™ — ALL RIGHTS RESERVED
    </div>
  </div>
</section>
