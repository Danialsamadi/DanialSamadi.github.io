---
import { Image } from "astro:assets";
import HeroImg from "@/ghost.gif";
import { QUOTE, SITE_TITLE, GITHUB_USERNAME } from "@/consts";

const [first, last] = SITE_TITLE.split(" ");
---

<div
  class="hero-bg hidden md:block h-screen hero-bg-animate absolute top-0 overflow-hidden"
>
</div>
<section
  class="min-h-[calc(100vh-6rem)] !z-[20] relative w-full flex flex-col justify-between"
  id="hero"
>
  <div class="px-4 md:px-8 pt-8 flex justify-between tag opacity-60">
    <span>&gt;&gt;&gt; PERSONNEL FILE / {GITHUB_USERNAME.toUpperCase()}</span>
    <span class="hidden md:inline">LAT 45.4215 / LON -75.6972</span>
  </div>

  <div
    class="px-4 md:px-8 grid grid-cols-1 md:grid-cols-[1fr_auto] gap-4 items-center"
  >
    <div>
      <h1 class="font-display type-macro">
        {first}<br />
        <span class="text-hazard">{last}</span>
      </h1>
      <div
        class="mt-6 max-w-2xl border-l-2 border-hazard pl-4 py-1 tag text-sm"
      >
        {QUOTE}
      </div>
    </div>
    <div class="hidden md:block border border-[#2a2a2a] p-2 relative">
      <span class="absolute top-1 left-2 tag opacity-50">SPECIMEN / 👻-01</span>
      <Image
        alt="ghost"
        src={HeroImg}
        class="invert brightness-200 contrast-125 w-56 lg:w-72"
      />
      <span class="absolute bottom-1 right-2 tag opacity-50">NON-HOSTILE</span>
    </div>
  </div>

  <div class="border-t border-[#2a2a2a] mt-10">
    <div class="flex flex-col sm:flex-row sm:flex-wrap items-stretch">
      <a
        href="#operations"
        class="px-6 py-4 bg-hazard text-[#0a0a0a] font-bold tag border-b sm:border-b-0 sm:border-r border-[#2a2a2a] hover:opacity-80 transition-opacity"
      >
        [ VIEW OPERATIONS ]
      </a>
      <a
        href="/Resume.pdf"
        target="_blank"
        rel="noopener noreferrer"
        class="px-6 py-4 tag border-b sm:border-b-0 sm:border-r border-[#2a2a2a] hover:bg-[#eaeaea] hover:text-[#0a0a0a] transition-colors"
      >
        [ RESUME.PDF ]
      </a>
      <a
        href={`https://github.com/${GITHUB_USERNAME}`}
        target="_blank"
        rel="noopener noreferrer"
        class="px-6 py-4 tag sm:border-r border-[#2a2a2a] hover:bg-[#eaeaea] hover:text-[#0a0a0a] transition-colors"
      >
        [ GITHUB &gt;&gt;&gt; ]
      </a>
      <div class="hidden md:flex items-center px-6 tag opacity-50 ml-auto">
        SCROLL FOR TELEMETRY ▼
      </div>
    </div>
  </div>
</section>

<script is:inline>
  const hero_bg = document.querySelector(".hero-bg-animate");
  if (hero_bg) {
    setInterval(() => {
      let binaryText = "";
      for (let i = 0; i < 2000; i++) {
        binaryText += Math.floor(Math.random() * 2).toString();
      }
      hero_bg.textContent = binaryText;
    }, 300);
  }
</script>
