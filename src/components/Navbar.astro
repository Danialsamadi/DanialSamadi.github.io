---
import { SITE_TITLE, NAV_LINKS as links } from "@/consts";
---

<nav
  class="w-full !z-[9999] border-b border-[#2a2a2a] bg-[#0a0a0a]/95 backdrop-blur-sm"
>
  <div class="flex flex-wrap items-stretch justify-between">
    <a
      href="/"
      class="flex items-center gap-2 md:gap-3 px-3 md:px-4 py-3 border-r border-[#2a2a2a] hover:bg-[#eaeaea] hover:text-[#0a0a0a] transition-colors shrink-0"
    >
      <span class="bg-hazard w-2 h-2 inline-block blink"></span>
      <span class="tag font-bold whitespace-nowrap">{SITE_TITLE} ®</span>
    </a>
    <div class="hidden lg:flex items-center px-4 tag opacity-50">
      SYS.PORTFOLIO / REV 2.6 / ONLINE
    </div>
    <div class="flex items-stretch flex-1 justify-end">
      {
        links.map((link) => {
          const href =
            link.href ?? link.title.toLowerCase().replaceAll(" ", "-");
          const pathname = Astro.url.pathname.replace(
            import.meta.env.BASE_URL,
            "",
          );
          const subpath = pathname.match(/[^\/]+/g);
          const isActive =
            href === pathname || href === "/" + (subpath?.[0] || "");
          return (
            <a
              class:list={[
                "flex items-center px-2 sm:px-3 md:px-5 py-3 border-l border-[#2a2a2a] tag whitespace-nowrap transition-colors",
                isActive
                  ? "bg-hazard text-[#0a0a0a] font-bold"
                  : "hover:bg-[#eaeaea] hover:text-[#0a0a0a]",
              ]}
              href={`/${href}`}
            >
              [ {link.title} ]
            </a>
          );
        })
      }
    </div>
  </div>
</nav>
