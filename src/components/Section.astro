---
type Props = {
  title: string;
  index?: string;
  className?: string;
};
const { title = "Section", index = "00", className = "" } = Astro.props;
---

<section
  id={title.toLowerCase().replaceAll(" ", "")}
  class={`w-screen !overflow-x-hidden border-t border-[#2a2a2a] ${className}`}
>
  <div
    class="flex items-baseline justify-between px-4 md:px-8 pt-10 pb-6 gap-4"
  >
    <h2 class="font-display type-section">
      {title}
    </h2>
    <div class="tag opacity-50 shrink-0">
      /// SEC.{index}
    </div>
  </div>
  <div class="w-full px-4 md:px-8 pb-16">
    <slot />
  </div>
</section>
