---
import Hero from "@/components/Hero.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import Section from "@/components/Section.astro";
import Layout from "@/layouts/Layout.astro";
import { KNOWN_TECH, ABOUT_ME, GITHUB_USERNAME } from "@/consts";
import { getProjects } from "@/lib/projects";

const projects = await getProjects();
const featured = projects.slice(0, 6);
const totalStars = projects.reduce((n, p) => n + p.stars, 0);
---

<Layout title="Danial Samadi Portfolio">
  <Hero />

  <Section title="Operations" index="01">
    <div class="tag opacity-60 mb-6">
      LIVE FEED / API.GITHUB.COM / {projects.length} UNITS TRACKED / {
        totalStars
      } STARS AGGREGATE
    </div>
    <div class="blueprint grid-cols-1 md:grid-cols-2 lg:grid-cols-3">
      {featured.map((p, i) => <ProjectCard project={p} index={i} />)}
    </div>
    <div class="flex justify-end mt-6">
      <a
        href="/projects"
        class="tag border border-[#2a2a2a] px-6 py-3 hover:bg-hazard hover:text-[#0a0a0a] transition-colors"
      >
        [ FULL REGISTRY / {projects.length} UNITS &gt;&gt;&gt; ]
      </a>
    </div>
  </Section>

  <Section title="Capabilities" index="02">
    <div class="flex flex-wrap gap-2 max-w-4xl">
      {KNOWN_TECH.map((x) => <Breadcrumb title={x} />)}
    </div>
  </Section>

  <Section title="Dossier" index="03">
    <div class="blueprint grid-cols-1 md:grid-cols-3 max-w-6xl">
      <div class="p-5 tag opacity-60 md:col-span-1">
        <p>SUBJECT / DANIAL SAMADI</p>
        <p class="mt-2">ROLE / FULL-STACK DEVELOPER</p>
        <p class="mt-2">
          EDU / ALGONQUIN COLLEGE — COMPUTER PROGRAMMING / GRADUATED DEC 2025
        </p>
        <p class="mt-2">SRC / GITHUB.COM/{GITHUB_USERNAME.toUpperCase()}</p>
      </div>
      <div
        class="p-5 md:col-span-2 text-sm leading-relaxed whitespace-pre-line opacity-90"
      >
        {ABOUT_ME}
      </div>
    </div>
  </Section>
</Layout>
